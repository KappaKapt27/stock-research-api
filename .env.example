# Copy this file to .env and fill in values as needed.

APP_NAME=stock-research-api
APP_ENV=development
APP_DEBUG=true
DATA_PROVIDER=yahoo

# Optional provider credentials. Required only when using those providers.
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Optional request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=10
